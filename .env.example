# ========================================================
# XuPay - Environment Configuration
# Copy to .env and change the values before running:
#   cp .env.example .env
#   docker compose up -d --build
# The defaults in docker-compose.yml are for LOCAL DEV ONLY.
# ========================================================

# --- Databases ---
USER_DB_PASSWORD=UserS3rv1c3P@ss2025!
PAYMENT_DB_PASSWORD=P@ym3ntS3rv1c3P@ss2025!

# --- Redis ---
REDIS_PASSWORD=R3d1sP@ss2025!

# --- KYC reviewer account (created or promoted at user-service startup) ---
ADMIN_EMAIL=admin@xupay.local
ADMIN_PASSWORD=Admin@12345

# --- JWT (min 256-bit secret) ---
JWT_SECRET=YourSuperSecretJWTKeyForProductionUseAtLeast256BitsChangeThis2025!

# --- Sign-in cookie ---
# The web app's token is an HttpOnly, SameSite=Strict cookie. Set this to true
# wherever the app is served over HTTPS so the cookie is never sent over plain
# HTTP; leave it false for local http://localhost.
AUTH_COOKIE_SECURE=false

# --- Service-to-service gRPC token (min 32 characters) ---
# payment-service presents it on every call to user-service's gRPC API, and
# user-service refuses calls without it. Both services read this one value.
GRPC_SERVICE_TOKEN=LocalDevGrpcServiceTokenChangeThisInDotEnv2025!

# --- Hibernate schema mode: keep "update" ---
# The SQL schema (infrastructure/db + the Flyway migrations) does not yet
# create every column the entities map - e.g. user_preferences and
# user_contacts.updated_at - and Hibernate's "update" adds them at startup.
# "validate" refuses to start against that schema, so do not use it until
# migrations cover the whole model.
JPA_DDL_AUTO=update

# --- URLs the BROWSER uses to reach the APIs ---
NEXT_PUBLIC_USER_SERVICE_URL=http://localhost:8081
NEXT_PUBLIC_PAYMENT_SERVICE_URL=http://localhost:8082
